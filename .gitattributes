# ─────────────────────────────────────────────────────────────────────────
# 줄바꿈과 바이너리 취급 규칙
#
# 이 프로젝트는 줄바꿈 때문에 실제로 두 번 데였다:
#   - PowerShell 5.1 은 .ps1 을 ANSI로 읽는다 (BOM 없는 UTF-8 한글이 파서 에러)
#   - 유니티 로그는 CRLF라 정규식의 \n 이 매칭에 실패했다
#   - Select-String 과 Get-Content 의 줄 번호가 어긋나 줄 기반 분할이 위험했다
# 그래서 규칙을 명시해 둔다.
# ─────────────────────────────────────────────────────────────────────────

# 기본: 텍스트는 git이 판단, 체크아웃 시 OS 관행에 맞춘다
* text=auto

# 강제 LF — 크로스 플랫폼 도구
*.js    text eol=lf
*.mjs   text eol=lf
*.json  text eol=lf
*.py    text eol=lf
*.sh    text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

# 강제 CRLF — 윈도우 전용
*.ps1   text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf

# C# / 셰이더는 윈도우 툴체인이 주로 다룬다
*.cs      text eol=crlf
*.shader  text eol=crlf
*.hlsl    text eol=crlf
*.cginc   text eol=crlf

# 유니티 에셋 — YAML 텍스트지만 병합은 사람이 하지 않는다
*.unity          text eol=lf -merge
*.prefab         text eol=lf -merge
*.asset          text eol=lf -merge
*.mat            text eol=lf -merge
*.controller     text eol=lf -merge
*.meta           text eol=lf -merge

# 바이너리 — 변환 금지 (하나라도 텍스트로 취급되면 파일이 손상된다)
*.glb   binary
*.fbx   binary
*.blend binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.mp4   binary
*.zip   binary
*.dll   binary
*.pdb   binary
*.unitypackage binary

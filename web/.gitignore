# ─────────────────────────────────────────────────────────────────────────
# 브라우저 모듈 (기준 = reference truth)
#
# 커밋하는 것:  src/  index.html  server.mjs  package.json  package-lock.json
# 무시하는 것:  의존성, 익스포트 산출물, 스크린샷
# ─────────────────────────────────────────────────────────────────────────

# 의존성 (22MB) — package-lock.json 으로 재현된다
node_modules/

# 익스포트 산출물 (16MB) — 브라우저에서 __export 로 다시 뽑는다.
#
# 커밋하지 않는 이유: 설계 단계에서 메시를 반복 수정하면 매번 16MB 바이너리가
# 히스토리에 쌓인다. 승인된 스펙은 pipeline/contract.json 의 숫자로 기록되므로
# GLB 자체를 보관할 필요가 없다.
#
# 클론 직후 파이프라인을 돌리려면 먼저 브라우저에서 익스포트해야 한다 (README 참고).
export/

# 스크린샷·검증 이미지 (42MB) — 전부 재생성 가능한 디버그 출력
shots/

# 로컬 실험용
scratch/
*.local.js
